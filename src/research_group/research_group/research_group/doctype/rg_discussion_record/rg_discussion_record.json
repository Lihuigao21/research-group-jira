{
  "doctype": "DocType",
  "name": "RG Discussion Record",
  "module": "Research Group",
  "custom": 0,
  "autoname": "format:RG-DIS-{#####}",
  "naming_rule": "Expression",
  "engine": "InnoDB",
  "title_field": "topic",
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "appointment",
    "topic",
    "student",
    "teacher",
    "discussed_at",
    "conclusion",
    "teacher_feedback",
    "actions",
    "recorded_at",
    "recorded_by"
  ],
  "fields": [
    {
      "fieldname": "appointment",
      "label": "对应预约",
      "fieldtype": "Link",
      "options": "RG Appointment",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "topic",
      "label": "课题",
      "fieldtype": "Link",
      "options": "RG Topic",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "student",
      "label": "学生",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "teacher",
      "label": "教师",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "discussed_at",
      "label": "讨论时间",
      "fieldtype": "Datetime",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "conclusion",
      "label": "讨论结论",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "teacher_feedback",
      "label": "教师意见",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "actions",
      "label": "后续行动",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "recorded_at",
      "label": "归档时间",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "recorded_by",
      "label": "归档人",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "课题组教师",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 0,
      "write": 0
    },
    {
      "role": "课题组学生",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 0,
      "write": 0
    }
  ],
  "actions": [],
  "links": [],
  "states": [],
  "protect_attached_files": 1,
  "show_name_in_global_search": 1
}
