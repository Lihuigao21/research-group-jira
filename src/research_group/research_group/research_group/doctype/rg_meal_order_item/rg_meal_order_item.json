{
  "doctype": "DocType",
  "name": "RG Meal Order Item",
  "module": "Research Group",
  "custom": 0,
  "engine": "InnoDB",
  "istable": 1,
  "track_changes": 0,
  "allow_rename": 0,
  "field_order": [
    "item_id",
    "category",
    "item_name",
    "price_cents",
    "quantity",
    "staple",
    "subtotal_cents"
