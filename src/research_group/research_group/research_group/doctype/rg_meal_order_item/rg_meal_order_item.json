      "reqd": 1
    },
    {
      "fieldname": "category",
      "label": "分类",
      "fieldtype": "Select",
      "options": "meal\naddon",
      "reqd": 1
    },
    {
      "fieldname": "item_name",
      "label": "餐品名称",
      "fieldtype": "Data",
      "ignore_xss_filter": 1,
      "length": 200,
      "reqd": 1
    },
    {
      "fieldname": "price_cents",
      "label": "单价（分）",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "quantity",
      "label": "份数",
      "fieldtype": "Int",
      "reqd": 1
    },
    {
      "fieldname": "staple",
      "label": "主食",
      "fieldtype": "Data",
      "ignore_xss_filter": 1,
      "length": 80
    },
    {
      "fieldname": "subtotal_cents",
      "label": "小计（分）",
      "fieldtype": "Int",
      "reqd": 1
    }
  ],
  "permissions": [],
  "actions": [],
  "links": [],
  "states": [],
  "show_name_in_global_search": 0,
  "protect_attached_files": 1,
  "sort_field": "creation",
