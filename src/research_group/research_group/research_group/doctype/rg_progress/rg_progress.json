{
  "doctype": "DocType",
  "name": "RG Progress",
  "module": "Research Group",
  "custom": 0,
  "autoname": "format:RG-PRG-{#####}",
  "naming_rule": "Expression",
  "engine": "InnoDB",
  "title_field": "topic",
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "topic",
    "student",
    "progress_date",
    "summary",
    "blockers",
    "next_milestone",
    "recorded_at"
  ],
  "fields": [
    {
      "fieldname": "topic",
      "label": "课题",
      "fieldtype": "Link",
      "options": "RG Topic",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "student",
      "label": "所属学生",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "progress_date",
      "label": "进展日期",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1
    },
    {
      "fieldname": "summary",
      "label": "本次进展",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "blockers",
      "label": "当前阻碍",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "next_milestone",
      "label": "下一步与里程碑",
      "fieldtype": "Small Text",
      "reqd": 1
    },
    {
      "fieldname": "recorded_at",
      "label": "服务端记录时间",
      "fieldtype": "Datetime",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "课题组教师",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 0,
      "write": 0
    },
    {
      "role": "课题组学生",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1
    }
  ],
  "actions": [],
  "links": [],
  "states": [],
  "protect_attached_files": 1,
  "show_name_in_global_search": 1
}
