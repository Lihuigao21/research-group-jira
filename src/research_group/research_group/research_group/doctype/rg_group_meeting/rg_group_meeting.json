{
  "doctype": "DocType",
  "name": "RG Group Meeting",
  "module": "Research Group",
  "custom": 0,
  "autoname": "format:RG-MTG-{#####}",
  "naming_rule": "Expression",
  "engine": "InnoDB",
  "title_field": "title",
  "track_changes": 1,
  "allow_rename": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "title",
    "start_at",
    "end_at",
    "location",
    "deadline",
    "publisher",
    "status",
    "notes",
    "reporter_list"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "组会名称",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "start_at",
      "label": "开始时间",
      "fieldtype": "Datetime",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "end_at",
      "label": "结束时间",
      "fieldtype": "Datetime",
      "reqd": 1
    },
    {
      "fieldname": "location",
      "label": "地点",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "deadline",
      "label": "材料截止时间",
      "fieldtype": "Datetime",
      "description": "默认组会前一天 23:59；逾期仍可提交并标记。"
    },
    {
      "fieldname": "publisher",
      "label": "发布者",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "发布状态",
      "fieldtype": "Select",
      "options": "草稿\n已发布",
      "default": "草稿",
      "read_only": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "notes",
      "label": "安排说明",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "reporter_list",
      "label": "报告安排",
      "fieldtype": "HTML"
    }
  ],
  "permissions": [
    {
      "role": "课题组教师",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "课题组秘书",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "课题组学生",
      "read": 1,
      "select": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "create": 0,
      "write": 0
    }
  ],
  "actions": [],
  "links": [],
  "states": [],
  "protect_attached_files": 1,
  "show_name_in_global_search": 1
}
