{
  "doctype": "DocType",
  "name": "RG Survey Question",
  "module": "Research Group",
  "custom": 0,
  "autoname": "hash",
  "naming_rule": "Random",
  "engine": "InnoDB",
  "title_field": "title",
  "track_changes": 0,
  "allow_rename": 0,
  "sort_field": "creation",
  "sort_order": "DESC",
  "field_order": [
    "title",
    "question_type",
    "required",
    "options"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "题目",
      "fieldtype": "Small Text",
      "in_list_view": 1,
      "columns": 5
    },
    {
      "fieldname": "question_type",
      "label": "题型",
      "fieldtype": "Select",
      "options": "单选\n多选\n简答",
      "default": "单选",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "required",
      "label": "必填",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "options",
      "label": "选项（每行一个）",
      "fieldtype": "Long Text",
      "description": "单选、多选至少两个不重复选项；简答留空。"
    }
  ],
  "permissions": [],
  "actions": [],
  "links": [],
  "states": [],
  "protect_attached_files": 1,
  "show_name_in_global_search": 0,
  "istable": 1,
  "editable_grid": 1
}
